# Copy this file to `.env` and fill in the values you need.
#   cp .env.example .env
#
# `.env` is gitignored — never commit real keys. In production (Railway) set
# these in the service's Variables tab instead; real environment variables
# always take precedence over this file.
#
# Every value here is OPTIONAL. Without them the game still runs; the features
# that need them just stay off.

# Anthropic API key for AI match recaps (server/commentary/).
# Get one at https://console.anthropic.com -> API keys -> Create Key.
# This is a SECRET — anyone holding it can spend your credits.
ANTHROPIC_API_KEY=

# Google OAuth client id for "Sign in with Google" (server/googleAuth.js).
# Not a secret; it's public by design.
GOOGLE_CLIENT_ID=

# Session-token signing secret. Unset = a random one per run, so everyone is
# logged out on restart. Generate a stable one with:
#   openssl rand -hex 32
PP_SECRET=

# Redis connection string. Set it to run AI recaps through a durable BullMQ
# queue; unset, they're generated in-process instead (fine for local dev).
REDIS_URL=

# Model used for AI recaps. Defaults to claude-haiku-4-5 — the cheapest, and
# plenty for a 3-sentence summary. Set claude-sonnet-5 or claude-opus-5 for
# richer writing at 3-5x the cost.
PP_RECAP_MODEL=

# AI recap spending limits (server/commentary/live.js). The endpoint is open to
# guests, so these are what bound your API bill. Defaults shown.
#   PP_RECAP_DAILY_MAX   total generations per UTC day, across everyone (300)
#   PP_RECAP_USER_HOURLY per signed-in player, per hour (20)
#   PP_RECAP_GUEST_HOURLY per IP address, per hour (5)
# The daily cap is the real backstop: per-IP limits can be dodged by rotating
# addresses, so it's the ceiling that guarantees a bounded worst case.
PP_RECAP_DAILY_MAX=
PP_RECAP_USER_HOURLY=
PP_RECAP_GUEST_HOURLY=

# Server port (default 3000).
PORT=
